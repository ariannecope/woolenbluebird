PORT=4000

# Local Postgres connection string.
# Update user/password/db name to match your local setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/woolenbluebird?schema=public"

# Comma-separated list of origins allowed to call the API in development.
CLIENT_ORIGIN=http://localhost:5173

# Admin auth (see server/scripts/hash-password.js to generate ADMIN_PASSWORD_HASH,
# and the README for how to generate ADMIN_JWT_SECRET). Never commit real values
# for these — only this file, with empty values, is tracked by git.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
